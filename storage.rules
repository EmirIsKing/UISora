rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can read/write their own files in uiJson/{userId}/ directory
    match /uiJson/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read/write their own files in project-ui/{projectId} directory
    match /project-ui/{projectId} {
      allow read, write: if request.auth != null;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 